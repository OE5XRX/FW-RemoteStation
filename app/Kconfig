config FM_BOOT_CONFIRM_SKIP_SA818
	bool "Skip the SA818 handshake in the boot-confirm health gate"
	default n
	help
	  Bench/HIL-only. Drops the SA818 AT-handshake criterion from the
	  boot-confirm health gate, so a trial image can self-confirm on a
	  bench that has no working SA818 (no radio / no 12 V rail) using
	  only the USB-enumerated and shell-active criteria. Without this,
	  the SA818 probe never succeeds and every trial image reverts.
	  NEVER enable this in a production build.

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

config FM_TEST_LOOPBACK
	bool "Test-only internal UAC2 audio loopback (SA818 bypass)"
	default n
	depends on USB_DEVICE_STACK_NEXT && SHELL
	help
	  Bench test mode. When armed at runtime it bridges the UAC2 OUT stream
	  (USB host -> device) straight back into the UAC2 IN stream
	  (device -> USB host), bypassing the SA818 radio entirely. Adds an
	  `audio loopback on|off|status` shell command to arm it. Intended for
	  hardware-in-the-loop verification of the host-side audio path without a
	  working radio link. Default n; never enable in a production build.

config FM_TEST_HANG_BEFORE_MAIN
	bool "Test-only: hang during boot, before main() (IWDG revert test)"
	default n
	depends on BOOTLOADER_MCUBOOT
	help
	  Bench test image for the MCUboot boot watchdog. Spins forever in a
	  PRE_KERNEL_2 init hook — right after the clock driver, before main()
	  and before the boot-confirm gate arms task_wdt — which is exactly where
	  a non-starting HSE crystal would leave the app. Loaded as a DFU trial
	  image it must be reset by the IWDG MCUboot armed
	  (CONFIG_BOOT_WATCHDOG_TIMEOUT_MS) and reverted to the previous slot.
	  Never flash it directly into slot0 over SWD: there is no older image
	  to revert to, so it would reset-loop until reflashed.
	  Default n; never enable in a production build.

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"
